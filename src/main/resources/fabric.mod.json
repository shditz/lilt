{
  "schemaVersion": 1,
  "id": "lilt",
  "version": "${version}",
  "name": "Lilt",
  "description": "Client-side performance monitor and workload stabilizer. Keeps framerates steady during intense scenes by managing particle strain, tracking frame intervals, and diagnosing bottlenecks.",
  "authors": ["shditz"],
  "contact": {
    "homepage": "https://github.com/shditz/lilt",
    "sources": "https://github.com/shditz/lilt",
    "issues": "https://github.com/shditz/lilt/issues"
  },
  "license": "MIT",
  "icon": "assets/lilt/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.lilt.client.LiltClient"],
    "main": ["dev.lilt.LiltMod"],
    "sodium:config_api_user": ["dev.lilt.compat.sodium.SodiumConfigEntry"]
  },
  "mixins": ["lilt.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": ">=26.1 <26.2",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "sodium": "*",
    "lithium": "*"
  }
}
